# Firebase 설정
# 실제 사용 시 이 파일을 .env로 복사하고 실제 값으로 변경하세요

# Firebase Web API Key
FIREBASE_API_KEY=your_api_key_here

# Firebase Project ID
FIREBASE_PROJECT_ID=swu-dormi-17962

# Firebase Messaging Sender ID
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here

# Firebase App ID
FIREBASE_APP_ID=your_app_id_here

# Firebase Storage Bucket
FIREBASE_STORAGE_BUCKET=swu-dormi-17962.firebasestorage.app

# Firebase Auth Domain
FIREBASE_AUTH_DOMAIN=swu-dormi-17962.firebaseapp.com

# 앱 설정
APP_NAME=SWU 샬롬하우스 관리자
APP_VERSION=1.0.0

# 디버그 모드
DEBUG_MODE=true
